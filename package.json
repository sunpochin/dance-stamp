{
  "name": "dance-stamp",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "bun --no-env-file scripts/check-harness.ts && bun --no-env-file scripts/check-public.ts && bun run test:unit && bun run typecheck && bun run lint && bun run build",
    "test:unit": "bun --no-env-file test --isolate ./tests/unit",
    "test:coverage": "bun --no-env-file test --isolate --coverage --coverage-reporter=text --coverage-reporter=lcov ./tests/unit",
    "test:coverage:app": "bun --no-env-file tests/app-coverage/prepare-fixtures.ts && bun --no-env-file tests/app-coverage/run-app.ts",
    "hooks:install": "bun --no-env-file scripts/install-hooks.ts",
    "probe": "bun run dev",
    "build": "bun --no-env-file scripts/build-web.ts",
    "package:web": "bun run build && bun --no-env-file scripts/package-web.ts",
    "check:package": "bun --no-env-file scripts/package-web.ts --check",
    "dev": "bun --watch --no-clear-screen --no-env-file scripts/serve-web.ts --watch",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.sw.json",
    "lint": "biome lint web --error-on-warnings"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@mediapipe/tasks-vision": "1.2.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
